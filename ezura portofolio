<script>
const menu=document.getElementById('menu'),nav=document.getElementById('nav');
menu?.addEventListener('click',()=>nav.classList.toggle('open'));
nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>nav.classList.remove('open')));
const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('show');observer.unobserve(entry.target)}}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));

const overlay=document.getElementById('commandOverlay'),search=document.getElementById('commandSearch'),list=document.getElementById('commandList');
function openCommand(){overlay.classList.add('open');search.value='';filterCommands();setTimeout(()=>search.focus(),40)}
function closeCommand(){overlay.classList.remove('open')}
document.getElementById('commandOpen')?.addEventListener('click',openCommand);
document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();openCommand()}if(e.key==='Escape'){closeCommand();document.getElementById('lightbox').classList.remove('open')}});
function filterCommands(){const q=search.value.toLowerCase();list.querySelectorAll('button').forEach(b=>b.style.display=b.textContent.toLowerCase().includes(q)?'block':'none')}
search.addEventListener('input',filterCommands);
list.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{document.querySelector(b.dataset.target)?.scrollIntoView({behavior:'smooth'});closeCommand()}));
overlay.addEventListener('click',e=>{if(e.target===overlay)closeCommand()});

const lightbox=document.getElementById('lightbox'),lightboxText=document.getElementById('lightboxText');
document.querySelectorAll('.gallery-tile').forEach(tile=>tile.addEventListener('click',()=>{lightboxText.textContent=tile.dataset.detail;lightbox.classList.add('open')}));
document.getElementById('lightboxClose').addEventListener('click',()=>lightbox.classList.remove('open'));
lightbox.addEventListener('click',e=>{if(e.target===lightbox)lightbox.classList.remove('open')});

const musicModal=document.getElementById('musicModal');
document.getElementById('musicToggle').addEventListener('click',()=>musicModal.classList.add('open'));
document.getElementById('musicClose').addEventListener('click',()=>musicModal.classList.remove('open'));
musicModal.addEventListener('click',e=>{if(e.target===musicModal)musicModal.classList.remove('open')});
document.addEventListener('keydown',e=>{if(e.key==='Escape')musicModal.classList.remove('open')});

let typed='';
document.addEventListener('keydown',e=>{if(['INPUT','TEXTAREA'].includes(document.activeElement.tagName))return;if(e.key.length===1){typed=(typed+e.key.toUpperCase()).slice(-5);if(typed==='EZURA'){const t=document.getElementById('easterToast');t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3200);typed=''}}});
document.querySelector('.brand')?.addEventListener('click',e=>{if(e.detail===3){const t=document.getElementById('easterToast');t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3200)}});
</script>

